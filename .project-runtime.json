{
  "schema_version": 1,
  "name": "switchyard-sequencer",
  "language": "python",
  "project_shape": "backend",
  "source_extensions": [".py"],
  "build_command": "python3 -m compileall -q src checks",
  "testing": "deferred",
  "workflow_checks": [
    {
      "workflow_id": "open-shift-classify-intake",
      "command": "PYTHONPATH=src python3 checks/wf_intake_classify.py"
    },
    {
      "workflow_id": "open-shift-classify-intake",
      "command": "PYTHONPATH=src python3 checks/wf_intake_manual_spot.py"
    },
    {
      "workflow_id": "plan-outbound-pull",
      "command": "PYTHONPATH=src python3 checks/wf_outbound_sequence.py"
    },
    {
      "workflow_id": "execute-pull-depart",
      "command": "PYTHONPATH=src python3 checks/wf_pull_depart.py"
    },
    {
      "workflow_id": "close-shift-balance",
      "command": "PYTHONPATH=src python3 checks/wf_close_shift.py"
    }
  ]
}
